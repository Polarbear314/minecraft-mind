# Minecraft Mind agent - Windows terrarium config (written by windows\setup.ps1)
MC_HOST=127.0.0.1
# Fixed port: the dedicated server never changes it (no more setport.py)
MC_PORT=25565
MC_USERNAME=MindBot
MC_AUTH=offline
MC_VERSION=1.21.4
VAULT_PATH=__VAULT_PATH__
TICK_INTERVAL_MS=1500
DECISION_MODE=claude-code
# Two-tier brain: Sonnet for moment-to-moment decisions, Opus for dreaming
LLM_MODEL=sonnet
DREAM_MODEL=opus
# Unattended runs use your Claude plan's usage on every consultation.
# 30s = ~120 consultations/hour. Lower it for a smarter-feeling bot,
# raise it if you keep hitting usage limits (rules take over when limited).
LLM_MIN_INTERVAL_MS=30000
DREAM_INTERVAL_MS=0
# Bot's-eye view in a browser: http://localhost:3007
VIEWER_PORT=3007
# If `claude` isn't found, point at the binary directly:
#CLAUDE_BIN=C:\Users\hrisch\.local\bin\claude.exe
