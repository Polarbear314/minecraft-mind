# Hostname or IP of the Minecraft Java Edition server (LAN world or dedicated server)
MC_HOST=localhost
# Port the server listens on (Esc -> Open to LAN prints one; dedicated servers default to 25565)
MC_PORT=25565
# Username the bot joins with (offline-mode/LAN worlds accept any name)
MC_USERNAME=MindBot
# Auth mode: 'offline' (LAN worlds, any name) or 'microsoft' (real account —
# set MC_USERNAME to your Microsoft email; first run prints a sign-in code)
MC_AUTH=offline
# Minecraft version, e.g. 1.21.4 — leave unset to let mineflayer auto-detect
#MC_VERSION=
# Absolute path to the Obsidian vault folder (the agent's brain)
VAULT_PATH=/absolute/path/to/your/vault/Agent Brain
# How often the agent thinks, in milliseconds (use 5000+ in llm mode)
TICK_INTERVAL_MS=1500
# Decision layer: 'rules' (built-in), 'llm' (Anthropic API), or 'claude-code'
# (Claude Code CLI — uses your Claude account login, no API key needed;
#  requires: npm install -g @anthropic-ai/claude-code, then run `claude` once to log in)
DECISION_MODE=rules
# Required only for llm mode — create a key at console.anthropic.com
#ANTHROPIC_API_KEY=sk-ant-...
# Claude model (haiku = fast + cheap; try claude-sonnet-5 for deeper reasoning)
LLM_MODEL=claude-haiku-4-5
# claude-code mode: consult Claude at most this often (ms); rules fill the gaps
LLM_MIN_INTERVAL_MS=10000
# Dreaming: the bot reflects on its vault every day-break; set this to ALSO
# dream every N ms (e.g. 600000 = 10 min). 0 or unset = day-break only.
DREAM_INTERVAL_MS=0
# Serve the bot's first-person view at http://localhost:<port> (0 or unset = off)
VIEWER_PORT=3007
